FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py config.py pytest.ini ./
COPY routes/ ./routes/
COPY utils/ ./utils/
COPY templates/ ./templates/
COPY static/ ./static/
COPY tests/ ./tests/

CMD ["pytest"]
